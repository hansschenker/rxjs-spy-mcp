{
  "name": "rxjs-spy",
  "version": "9.0.0-dev.0",
  "description": "A debugging library for RxJS 7 with an MCP-friendly in-page surface, driven via Chrome DevTools MCP",
  "author": "Nicholas Jamieson <nicholas@cartant.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./operators": {
      "import": {
        "types": "./dist/operators/index.d.ts",
        "default": "./dist/operators/index.js"
      },
      "require": {
        "types": "./dist/operators/index.d.cts",
        "default": "./dist/operators/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"harness/**/*.ts\" \"*.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "vite --open /harness/index.html",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "rxjs": "7.8.2",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansschenker/rxjs-spy-mcp.git"
  },
  "homepage": "https://github.com/hansschenker/rxjs-spy-mcp",
  "bugs": {
    "url": "https://github.com/hansschenker/rxjs-spy-mcp/issues"
  },
  "keywords": [
    "debug",
    "debugging",
    "devtools",
    "mcp",
    "observable",
    "rxjs",
    "spy"
  ],
  "contributors": [
    "Hans Schenker"
  ]
}
